{
  "name": "sayso-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node scripts/fetch-release.mjs && vite dev --port 3000",
    "release:fetch": "node scripts/fetch-release.mjs",
    "build": "node scripts/fetch-release.mjs && vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler pages deploy --branch main",
    "preview:cf": "pnpm run build && wrangler pages dev",
    "icons": "scripts/icons.sh"
  },
  "dependencies": {
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "lightningcss", "sharp", "workerd"]
  }
}
